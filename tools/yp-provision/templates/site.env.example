# Example non-interactive config for yp-provision
# cp site.env.example site.env && edit && ./bin/yp-provision --config ./site.env --yes

YP_MODE=greenfield   # or ha

YP_SSH_HOST=203.0.113.10
YP_SSH_PORT=22
YP_SSH_USER=root
# YP_SSH_KEY=/root/.ssh/id_ed25519
# or password via prompt / YP_SSH_PASS

YP_SITE_DOMAIN=crm.example.org
YP_SITE_NAME=Молодёжный центр Пример
YP_SITE_SHORT=МЦП
YP_ADMIN_EMAIL=admin@example.org
# YP_ADMIN_PASSWORD=...
YP_TZ=Europe/Moscow
YP_INSTALL_DIR=/opt/youth-portal
YP_HTTP_PORT=3000
YP_ENABLE_SSL=y
YP_LE_EMAIL=admin@example.org
YP_SOURCE_MODE=1
YP_PRIMARY_DIR=/opt/sochi-portal
